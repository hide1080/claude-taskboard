{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test:run)",
      "Bash(npm run build)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(git push *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "WebFetch(domain:attacker.example.com)",
      "Bash(curl:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-after-edit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-dangerous-command.sh"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        ".env",
        ".env.*",
        "**/.env",
        "**/.env.*"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "registry.npmjs.org"
      ]
    }
  }
}
